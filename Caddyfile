# Railway가 정해 주는 PORT 환경변수로 받는다 (로컬에서는 8080).
# https는 Railway가 앞단에서 처리한다 → 마이크·Web Serial이 동작하는 조건(https)을 만족.
:{$PORT:8080} {
	root * /srv
	encode gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# 외부 CDN·폰트를 쓰지 않는다는 규칙(CLAUDE.md 3)을 브라우저에서도 강제: 자기 주소의 파일만 허용
		Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'"
	}
}
